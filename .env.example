# Copy to .env and fill in. Never commit .env.

# --- TLS ----------------------------------------------------------------------
# Path to a CA bundle if HTTPS is intercepted (antivirus / corporate proxy). Leave empty otherwise.
CA_BUNDLE=

# --- Database ---------------------------------------------------------------
# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///data/nifty_nvp.db

# --- Time -------------------------------------------------------------------
# All timestamps are stored in UTC. This only controls display.
DISPLAY_TIMEZONE=Asia/Kolkata

# --- News providers ---------------------------------------------------------
# Comma-separated adapter names. Adapters that need a key are skipped when the key is empty.
# Available: google_news_rss (no key), publisher_rss (no key: ET, Mint, Business Standard, CNBC-TV18
# feeds from config/news_feeds.yaml), newsapi, gnews, marketaux
NEWS_PROVIDERS=google_news_rss,publisher_rss,newsapi,gnews,marketaux
NEWSAPI_KEY=
GNEWS_API_KEY=
MARKETAUX_API_KEY=

# --- Sentiment engine -------------------------------------------------------
# lexicon (default, deterministic) | finbert (needs requirements-finbert.txt)
SENTIMENT_ENGINE=lexicon

# --- Indian quarter convention ----------------------------------------------
# indian_fy (Q1 = Apr-Jun, FY27 = Apr 2026 - Mar 2027) | calendar (Q1 = Jan-Mar)
QUARTER_CONVENTION=indian_fy

# --- LLM validation ---------------------------------------------------------
# Reviews predictions only; it never changes the numeric prediction.
# openai | anthropic | ollama | none   (no automatic fallback between providers)
LLM_PROVIDER=openai
# OpenAI: both are required; without them validation is stored as "not performed".
OPENAI_API_KEY=
OPENAI_MODEL=
# Seconds per LLM request (optional)
LLM_TIMEOUT_S=120
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
